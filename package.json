{
  "name": "hachiorb-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "Grok Ball Pro nine-body floating desktop companion for Windows",
  "main": "src/main.cjs",
  "author": "HachiOrb contributors, based on Grok Ball by tycoding (MIT)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fetch:engine": "node scripts/bootstrap.cjs",
    "test": "node --test tests/*.test.cjs",
    "setup:agents": "node scripts/setup-integrations.cjs --all",
    "pack:win": "electron-packager . HachiOrb --platform=win32 --arch=x64 --out=release --overwrite --asar --icon=assets/app.ico --prune=true --ignore=^/release$ --ignore=^/tests$ --ignore=^/examples$ && node scripts/stage-portable-hooks.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "@electron/packager": "20.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
